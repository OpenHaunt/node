# Espressif ESP32-C6-DevKitC-1: Wi-Fi, WS2812 on GPIO8, BOOT on GPIO9, USB-serial-JTAG console.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_OH_BOARD_ESP32C6_DEVKITC_1=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/esp32c6-8mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/esp32c6-8mb.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_OH_TRANSPORT_WIFI_STA=y
CONFIG_OH_STATUS_LED_WS2812=y
