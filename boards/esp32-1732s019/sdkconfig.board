# Sunton ESP32-1732S019: ESP32-S3 N16R8, Wi-Fi, 1.9" ST7789 170x320 over SPI.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_OH_BOARD_ESP32_1732S019=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/esp32s3-16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/esp32s3-16mb.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_OH_TRANSPORT_WIFI_STA=y
CONFIG_OH_STATUS_LED_MONO_GPIO=y
CONFIG_OH_DISPLAY=y
