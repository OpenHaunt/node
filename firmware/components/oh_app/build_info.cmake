# Writes oh_build_info.c: the commit the image was built from and when.
# Runs on every build (see CMakeLists.txt), so the time is the build's, not the
# configure's, and a commit made since the last build is picked up.
#   cmake -DSRC=<repo dir> -DOUT=<file> -P build_info.cmake
execute_process(COMMAND git rev-parse --short=7 HEAD WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR commit STREQUAL "")
    set(commit "unknown")
else()
    # Uncommitted changes to tracked files; untracked ones (build output) do not count.
    execute_process(COMMAND git status --porcelain --untracked-files=no WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT changes STREQUAL "")
        string(APPEND commit "-dirty")
    endif()
endif()
string(TIMESTAMP when "%Y-%m-%dT%H:%M:%SZ" UTC)
file(WRITE "${OUT}" "/* Generated by build_info.cmake. */\nconst char oh_build_id[] = \"${commit}\";\nconst char oh_build_time[] = \"${when}\";\n")
