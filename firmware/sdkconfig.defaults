# Common to every board. Board-specific values live in boards/<board>/sdkconfig.board.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n

# IPv4 only: the-pult picks the first mDNS address it is given without
# filtering, and an unbracketed link-local IPv6 makes every HTTP call fail.
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_LOCAL_HOSTNAME="openhaunt"
CONFIG_LWIP_SO_RCVBUF=y
# A UDP socket queues this many packets, whatever SO_RCVBUF says. The stock 6 is
# 30 ms of the audio stream (a packet every 5 ms), and the receiving task was
# measured going 40-50 ms without the CPU every couple of seconds at HHG: each
# time the stack dropped the next packets, and the node played a hole
# (2026-10-28). 32 is 160 ms, beyond the stream's own buffer.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

CONFIG_MDNS_MAX_SERVICES=4
CONFIG_MDNS_PREDEF_NETIF_STA=y
CONFIG_MDNS_PREDEF_NETIF_ETH=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=n

CONFIG_MQTT_TASK_STACK_SIZE=6144

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# Two SNTP slots: the DHCP-provided server first, the pool as a fallback.
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Handlers on the default event loop log and touch the node store; the stock
# 2304-byte event task stack is not enough for that.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
