# OpenHaunt base board: ESP32-WROOM-32E/UE-N4, RMII Ethernet (RTL8201), external W25Q128.
CONFIG_IDF_TARGET="esp32"
CONFIG_OH_BOARD_OH_BASE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/oh-base-4mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/oh-base-4mb.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y
CONFIG_ETH_RMII_CLK_INPUT=y
CONFIG_ETH_RMII_CLK_IN_GPIO=0
CONFIG_OH_TRANSPORT_ETH_RMII=y
CONFIG_OH_STATUS_LED_NONE=y
